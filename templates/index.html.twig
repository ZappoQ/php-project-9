{% extends "layout.html.twig" %}

{% block title %}Анализатор страниц{% endblock %}

{% block content %}
    <div class="max-w-2xl mx-auto">
        <h1 class="text-3xl font-bold mb-4">Анализатор страниц</h1>
        <p class="text-gray-600 mb-6">Бесплатно проверяйте сайты на SEO-пригодность</p>

        <form action="/sites" method="POST" class="bg-white p-6 rounded-lg shadow">
            <div class="mb-4">
                <label for="url" class="block text-gray-700 font-medium mb-2">Введите URL:</label>
                <input
                        type="text"
                        name="url"
                        id="url"
                        class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="https://www.example.com"
                >
            </div>
            <button
                    type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"
            >
                Проверить
            </button>
        </form>
    </div>
{% endblock %}