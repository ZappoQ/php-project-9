<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Анализатор страниц{% endblock %}</title>
    <link href="/assets/css/main.css" rel="stylesheet">
</head>
<body class="min-h-screen bg-gray-100">
<nav class="bg-gray-800 text-white p-4">
    <div class="container mx-auto flex gap-6">
        <a href="{{ url_for('home') }}" class="font-bold hover:underline">Анализатор страниц</a>
        <a href="{{ url_for('urls.index') }}" class="hover:underline">Сайты</a>
    </div>
</nav>

<main class="container mx-auto p-4 mt-6">
    {% if flash is defined and flash %}
        {% for type, messages in flash %}
            {% for message in messages %}
                {% if type == 'success' %}
                    <div role="alert" class="mb-4 p-4 rounded bg-green-100 text-green-800">
                        {{ message }}
                    </div>
                {% else %}
                    <div role="alert" class="mb-4 p-4 rounded bg-red-100 text-red-800">
                        {{ message }}
                    </div>
                {% endif %}
            {% endfor %}
        {% endfor %}
    {% endif %}

    {% block content %}{% endblock %}
</main>
</body>
</html>