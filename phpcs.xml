<?xml version="1.0"?>
<ruleset name="Hexlet">
    <description>PSR-12 Coding Standard</description>

    <rule ref="PSR12"/>

    <file>src</file>
    <file>public/index.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/public/assets/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
</ruleset>
