{
    "name": "hexlet/code",
    "description": "Анализатор страниц (PHP)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.15.3",
        "slim/psr7": "^1.8",
        "slim/twig-view": "^3.4",
        "slim/flash": "^0.4.0",
        "vlucas/phpdotenv": "^5.7",
        "php-di/php-di": "^7.1",
        "guzzlehttp/guzzle": "^7.9",
        "symfony/dom-crawler": "^7.0",
        "symfony/css-selector": "^7.0",
        "vlucas/valitron": "^1.4",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}